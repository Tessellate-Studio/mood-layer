# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# Plain `.env` is ignored too (added 2026-08-13). Expo's template covers only
# `.env*.local`, leaving `.env` committable — and this app's first env var
# arrived the same week (EXPO_PUBLIC_SENTRY_DSN). That one is a write-only
# ingest key and harmless in a diff, but the next one may not be, and a repo
# whose whole posture is "nothing leaves the device" should not ship a
# committable secrets file. Values that must reach a build go through
# EXPO_PUBLIC_* + `eas env:create`, never a tracked file.
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# build artifacts (sideload APKs, Play bundles) — never commit binaries
*.apk
*.aab
mood-layer-apk/

# Claude Code worktrees (concurrent-session isolation)
.worktrees/
.claude/worktrees/

# roadmap-pulse state
.roadmap-pulse-state.json
research/*.pdf
