#!/bin/sh

# The Mood Layer — pre-push gate. LIGHT by design.
#
# The authoritative gate is ci.yml on the org's self-hosted runners (Tests job
# ~1 min there); merge on green is a standing directive. This hook is
# proportional to the diff, per forge/standards/workflows.md → "Local gates
# stay light" (user directive 2026-08-19, after full local jest runs blocked a
# docs-only push with load-induced 30s timeouts that CI then passed in 67s):
#
#   docs-only push  → nothing (seconds)
#   code push       → tsc --noEmit only
#   FULL_PREPUSH=1  → tsc + full jest locally (belt and braces)
#
# Escape hatch: git push --no-verify (discouraged — this hook is already cheap).
# (SKIP_PREPUSH_TESTS=1 is retired: the docs-only fast path is automatic now.)
#
# NOT included: `npm audit` — network-flaky in a hook; CI keeps it.

set -e

# ── §0 Worktree self-heal ────────────────────────────────────────────
# hooksPath MUST stay relative (".husky"): worktrees share repo config, and a
# relative path resolves against each worktree's own root. `|| true` is
# load-bearing under set -e (git config exits 1 when the key is unset).
WT_HOOKSPATH=$(git config --worktree core.hooksPath 2>/dev/null || true)
if [ -n "$WT_HOOKSPATH" ] && [ "$WT_HOOKSPATH" != ".husky" ] && [ -f .husky/pre-push ]; then
  git config --worktree core.hooksPath .husky
  echo "🔁 hooksPath was '$WT_HOOKSPATH' — reset to relative '.husky'; re-running this worktree's own hook"
  exec sh .husky/pre-push "$@"
fi

echo "🚀 pre-push (light — CI on the runners is the real gate)"

# ── §1 What does this push change? ───────────────────────────────────
if git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
  RANGE_BASE=$(git rev-parse '@{u}')
else
  git fetch origin master --quiet 2>/dev/null || true
  RANGE_BASE=$(git merge-base HEAD origin/master 2>/dev/null || echo "")
fi
if [ -n "$RANGE_BASE" ]; then
  PUSH_FILES=$(git diff --name-only "$RANGE_BASE"..HEAD)
else
  PUSH_FILES=$(git diff --name-only HEAD~5..HEAD 2>/dev/null || git ls-files)
fi

NEED_TSC=0
{ echo "$PUSH_FILES" | grep -qE '\.(ts|tsx|js|jsx|mjs|cjs|json)$' && NEED_TSC=1; } || true

if [ "$NEED_TSC" -eq 0 ]; then
  echo "📄 Docs-only push — nothing to gate locally. CI still runs on the PR."
  exit 0
fi

# ── §2 Bootstrap + lockfile freshness (only now that tsc will run) ───
if [ ! -d node_modules ]; then
  echo "❌ node_modules missing — this push contains code and tsc needs deps."
  echo "   Fix: npm ci"
  exit 1
fi

# `npm ci`, NOT `npm install` — npm install silently REWROTE package-lock.json
# on every run here (Windows prunes optional wasm entries only npm ci reads) —
# the exact lockfile corruption of regression row 13. A gate that mutates
# tracked files is not a gate. npm ci's tree-wipe can lose a race with
# Defender (ENOTEMPTY) — LOUD and retryable; the corruption was silent.
LOCK_CACHE="$(git rev-parse --git-dir)/.pre-push-lock-sha"
LOCK_SHA=$(sha256sum package-lock.json | cut -d' ' -f1)
NEED_INSTALL=0
if [ -f "$LOCK_CACHE" ]; then
  [ "$LOCK_SHA" != "$(cat "$LOCK_CACHE")" ] && NEED_INSTALL=1
elif [ ! -f node_modules/.package-lock.json ] || [ package-lock.json -nt node_modules/.package-lock.json ]; then
  NEED_INSTALL=1
fi

if [ "$NEED_INSTALL" -eq 1 ]; then
  echo "📦 lockfile changed — installing from it (npm ci)"
  npm ci --ignore-scripts --no-audit --no-fund || {
    echo "⚠️  npm ci failed — retrying once (the tree-wipe race is transient)"
    npm ci --ignore-scripts --no-audit --no-fund || {
      echo "❌ dependency install failed. If this is ENOTEMPTY, just push again."
      echo "   Do NOT 'fix' it with npm install — that prunes the lockfile (row 13)."
      exit 1
    }
  }
fi

if ! git diff --quiet -- package-lock.json; then
  echo "❌ package-lock.json was modified by the pre-push install — refusing to push."
  echo "   Restore it (git checkout -- package-lock.json) and push again."
  exit 1
fi
echo "$LOCK_SHA" > "$LOCK_CACHE"

# ── §3 Checks — tsc always (for code pushes), jest only on request ───
echo "── tsc --noEmit"
npx tsc --noEmit || { echo "❌ typecheck failed — push blocked"; exit 1; }

if [ "${FULL_PREPUSH:-0}" = "1" ]; then
  echo "── jest --no-coverage --ci (FULL_PREPUSH=1)"
  npx jest --no-coverage --ci || { echo "❌ tests failed — push blocked"; exit 1; }
else
  echo "ℹ️  jest runs on CI (the merge gate) — FULL_PREPUSH=1 to run it locally too"
fi

echo "✅ pre-push checks passed"
